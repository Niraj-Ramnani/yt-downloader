<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Video to mp3 Downloader</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <h1>YouTube Downloader</h1>
        <p>Convert YouTube videos to mp3 file downloadable links in seconds!</p>
        <img src="/images/icon1.gif" alt="Music Wave GIF" class="header-gif">
    </header>
    <main>
        <section class="converter">
            <div class="gif-container">
                <img src="/images/loader-unscreen.gif" alt="Loading Spinner GIF" class="loading-gif" style="display: none;">
            </div>
            <form action="/convert" method="POST" class="converter-form" id="downloadForm">
                <input
                    type="text"
                    name="videoLink"
                    placeholder="Paste YouTube video URL here"
                    value="<%= videoLink || '' %>"
                    required
                />
                <button type="submit">Get Download Link</button>
            </form>

            <% if (success !== null) { %>
                <div class="result <%= success ? 'success' : 'error' %>">
                    <p><%= message %></p>
                    <% if (success && song_link) { %>
                        <h3><%= song_title %></h3>
                        <a href="<%= song_link %>" target="_blank" class="download-btn">Download Now</a>
                    <% } %>
                </div>
            <% } %>
        </section>
    </main>
    <footer>
        <p>© 2025 YouTube to mp3 Downloader. Made by Niraj Ramnani . | <a href="https://www.linkedin.com/in/niraj-ramnani/" target="_blank">LinkedIN</a></p>
    </footer>
    <script src="/js/script.js"></script>
</body>
</html>